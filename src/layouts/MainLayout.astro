---
import "../styles/global.css";
import FloatingBar from "../components/FloatingBar.astro";
import CustomCursor from "../components/CustomCursor.astro";
import Preloader from "../components/Preloader.astro";
const { title = "Muhammad Raid Zaidani (zidan-idz) — Fullstack Developer & Game Creator" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    
    <meta name="description" content="Muhammad Raid Zaidani (zidan-idz) — Fullstack Developer & Game Creator from Lombok, Indonesia specializing in Web Applications, Python Backends, and Godot 2D Games." />
    <meta name="keywords" content="Muhammad Raid Zaidani, zidan-idz, Fullstack Developer, Game Developer, Python, Django, Astro, Lombok, Indonesia" />
    <meta name="author" content="Muhammad Raid Zaidani (zidan-idz)" />

    <!-- OpenGraph Meta Tags (WhatsApp, LinkedIn, Facebook Preview) -->
    <meta property="og:title" content="Muhammad Raid Zaidani (zidan-idz) — Fullstack Developer" />
    <meta property="og:description" content="Personal portfolio of Muhammad Raid Zaidani. Specialized in engineering full-scale digital solutions, from modern web applications to interactive games." />
    <meta property="og:image" content="/images/profile.jpg" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Muhammad Raid Zaidani (zidan-idz) — Fullstack Developer" />
    <meta name="twitter:description" content="Personal portfolio of Muhammad Raid Zaidani. Specialized in engineering full-scale digital solutions, from modern web applications to interactive games." />
    <meta name="twitter:image" content="/images/profile.jpg" />

    <!-- Favicon -->
    <link rel="icon" type="image/webp" href="/images/icon.webp" />
    <link rel="apple-touch-icon" href="/images/icon.webp" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Muhammad Raid Zaidani",
        "alternateName": "zidan-idz",
        "url": "https://zidan-idz.my.id",
        "image": "https://zidan-idz.my.id/images/profile.jpg",
        "jobTitle": "Fullstack Developer & Game Creator",
        "description": "Personal portfolio of Muhammad Raid Zaidani. Specialized in engineering full-scale digital solutions, from modern web applications to interactive games.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Lombok",
          "addressCountry": "Indonesia"
        },
        "sameAs": [
          "https://github.com/zidan-idz"
        ]
      }
    </script>
  </head>

  <body class="bg-bg-base text-text-primary antialiased overflow-x-hidden min-h-screen relative">
    
    <Preloader />
    <CustomCursor />
    
    <!-- Global Noise Grain Texture -->
    <div class="fixed inset-0 z-[-1] bg-noise"></div>
    
    <!-- Center Guideline (Optional Blueprint Aesthetic) -->
    <div class="fixed left-1/2 top-0 bottom-0 w-px bg-border-strong opacity-20 hidden 2xl:block pointer-events-none z-[-1]"></div>
    
    <slot />
    
    <FloatingBar />

    <script>
      import ScrollReveal from 'scrollreveal';
      import Lenis from 'lenis';

      document.addEventListener("DOMContentLoaded", () => {
        // Initialize Lenis Smooth Scroll
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // https://www.desmos.com/calculator/brs54l4xou
          direction: 'vertical',
          gestureDirection: 'vertical',
          smooth: true,
          mouseMultiplier: 1,
          smoothTouch: false,
          touchMultiplier: 2,
          infinite: false,
        })
        
        // Expose lenis globally for components like FloatingBar to control scroll lock
        window.lenis = lenis;

        // Get scroll value
        // lenis.on('scroll', (e) => {
        //   console.log(e)
        // })

        function raf(time) {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }
        requestAnimationFrame(raf)

        const sr = ScrollReveal({
          distance: '40px',
          duration: 800,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)', // Snappy, Apple-like ease out
          opacity: 0,
          scale: 1,
          mobile: true,
          reset: false // Do not animate out (anti-lag and glitch)
        });

        // Initialize standard fades
        sr.reveal('.anim-fade-up', { origin: 'bottom' });
        
        // Specific delays if present
        sr.reveal('.anim-fade-up.delay-100', { delay: 100 });
        sr.reveal('.anim-fade-up.delay-200', { delay: 200 });
        sr.reveal('.anim-fade-up.delay-300', { delay: 300 });
        sr.reveal('.anim-fade-up.delay-400', { delay: 400 });

        // Instant Counter Animations (Zero Delay on Viewport Entry)
        const counterObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const el = entry.target;
              const targetStr = el.getAttribute('data-count');
              if (!targetStr) return;
              
              const isPlus = targetStr.includes('+');
              const isK = targetStr.includes('K');
              const target = parseInt(targetStr.replace(/\D/g, ''));
              
              if (isNaN(target)) return;

              const duration = 1200; // 1.2s snappy counting
              const startTime = performance.now();

              function updateCounter(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                
                // easeOutQuart: starts instantly, finishes smoothly
                const easeOut = 1 - Math.pow(1 - progress, 4);
                
                const current = Math.floor(easeOut * target);
                
                let display = current.toString();
                if (isK) display = display + 'K';
                if (isPlus) display = display + '+';
                
                el.innerText = display;

                if (progress < 1) {
                  requestAnimationFrame(updateCounter);
                }
              }

              requestAnimationFrame(updateCounter);
              counterObserver.unobserve(el);
            }
          });
        }, { threshold: 0.05 });

        document.querySelectorAll('.counter-up').forEach(el => {
          counterObserver.observe(el);
        });

        // ── Dynamic Tab Title (Attention Retention) ──
        let originalTitle = document.title;
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) {
            document.title = "Hey, come back!";
          } else {
            document.title = originalTitle;
          }
        });

        // ── Konami Code Easter Egg ──
        const konamiCode = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
        let konamiPosition = 0;
        
        document.addEventListener('keydown', (e) => {
          if (e.key === konamiCode[konamiPosition]) {
            konamiPosition++;
            if (konamiPosition === konamiCode.length) {
              activateGlitchMode();
              konamiPosition = 0;
            }
          } else {
            konamiPosition = 0;
          }
        });

        function activateGlitchMode() {
          // Add a chaotic class to body
          document.body.classList.toggle('glitch-active');
          
          // Optionally flash colors
          let flashes = 0;
          const glitchInterval = setInterval(() => {
            document.body.style.filter = flashes % 2 === 0 ? 'invert(100%) hue-rotate(180deg) saturate(300%)' : 'none';
            document.body.style.transform = flashes % 2 === 0 ? 'translate(5px, 5px) skewX(2deg)' : 'none';
            flashes++;
            if (flashes > 15) {
              clearInterval(glitchInterval);
              document.body.style.filter = 'none';
              document.body.style.transform = 'none';
              // Keep the custom background theme permanently active
              if (document.body.classList.contains('glitch-active')) {
                document.body.style.filter = 'contrast(1.2) hue-rotate(90deg)';
              } else {
                document.body.style.filter = '';
              }
            }
          }, 80);
          console.log('[SYSTEM] KONAMI CODE ACTIVATED');
        }

      });
    </script>
  </body>
</html>
