---
// Projects.astro
// Bagian yang menampilkan daftar karya/proyek unggulan (Featured Projects).
// Menampilkan komponen ProjectCard secara dinamis berdasarkan data,
// dengan sistem pagination lokal (Tombol "Load More") menggunakan Javascript.
import { getProjects } from "../../lib/dataFetcher";
import ProjectCard from "../ui/ProjectCard.astro";

// Ambil daftar proyek (default diurutkan secara descending jika dari DB)
const projects = await getProjects();
---

<section id="work" class="relative overflow-hidden border-b-blueprint bg-bg-base">
  <!-- Latar Belakang Garis Blueprint (Architectural Grid) -->
  <div
    class="absolute inset-0 z-0 opacity-[0.02]"
    style="background-image: linear-gradient(var(--text-primary) 1px, transparent 1px), linear-gradient(90deg, var(--text-primary) 1px, transparent 1px); background-size: 80px 80px;"
  >
  </div>

  <div class="max-w-[1400px] mx-auto border-x-0 2xl:border-x border-border-strong relative z-10">
    <!-- Bagian Judul (Header) -->
    <div
      class="py-8 px-4 md:py-12 md:px-12 lg:py-16 border-b border-border-strong flex justify-between items-start md:items-end flex-wrap gap-8"
    >
      <div class="flex flex-col gap-6">
        <div class="anim-fade-up flex items-center gap-4">
          <div class="w-8 md:w-12 h-px bg-text-primary"></div>
          <div
            class="mono text-[10px] md:text-xs uppercase tracking-widest font-bold text-text-primary"
          >
            SELECTED WORKS / 03
          </div>
        </div>
        <h2
          class="anim-fade-up delay-100 text-5xl md:text-8xl lg:text-[7rem] font-serif font-black tracking-tight leading-[0.9]"
        >
          Featured<br />Projects.
        </h2>
      </div>

      <!-- Penghitung Total Proyek (Total Archives) -->
      <div class="anim-fade-up delay-200 text-left md:text-right pb-2 w-full md:w-auto">
        <div class="mono text-[10px] uppercase tracking-widest text-text-muted mb-2">
          Total Archives
        </div>
        <div class="serif text-4xl font-bold">
          {projects.length < 10 ? `0${projects.length}` : projects.length}
        </div>
      </div>
    </div>

    <!-- Daftar Proyek (Project List) -->
    <div id="projects-list" class="flex flex-col">
      {
        projects.map((project, index) => (
          // Jika index >= 5, sembunyikan proyek (disiapkan untuk tombol "Load More")
          <div
            class={`project-card-wrapper transition-all duration-500 ${index >= 5 ? "hidden opacity-0 translate-y-8" : ""}`}
            data-project-index={index}
          >
            <ProjectCard
              index={index + 1}
              title={project.title}
              category={project.category}
              description={project.description}
              techStack={project.techStack}
              link={project.link}
              demo={project.demo}
              image={project.image}
            />
          </div>
        ))
      }
    </div>

    {
      /* Tampilkan Tombol Load More hanya jika jumlah proyek lebih dari 5 */
      projects.length > 5 && (
        <div
          id="load-more-container"
          class="py-12 px-4 md:px-12 border-t border-border-strong flex justify-center bg-bg-base"
        >
          <button
            id="btn-load-more"
            class="mono text-xs font-bold uppercase tracking-[0.25em] px-8 py-4 bg-text-primary text-bg-base hover:bg-surface hover:text-text-primary border border-border-strong rounded-full transition-all duration-300 shadow-xl flex items-center gap-3 group cursor-pointer"
          >
            <span id="btn-load-more-text">LOAD MORE</span>
            <i
              id="btn-load-more-icon"
              class="ri-add-line text-base group-hover:rotate-180 transition-transform duration-500"
            />
          </button>
        </div>
      )
    }
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Ambil elemen DOM untuk Load More
    const loadMoreBtn = document.getElementById("btn-load-more");
    const loadMoreText = document.getElementById("btn-load-more-text");
    const loadMoreIcon = document.getElementById("btn-load-more-icon");

    if (!loadMoreBtn) return;

    let currentlyVisible = 5; // Jumlah yang terlihat di awal
    const step = 5; // Jumlah tambahan tiap kali klik "Load More"
    const allWrappers = document.querySelectorAll(".project-card-wrapper");
    const totalProjects = allWrappers.length;

    // Tambahkan Event Listener Klik pada tombol Load More
    loadMoreBtn.addEventListener("click", () => {
      // Hitung batasan berikutnya (next limit)
      const nextLimit = Math.min(currentlyVisible + step, totalProjects);

      // Tampilkan proyek tambahan
      for (let i = currentlyVisible; i < nextLimit; i++) {
        const wrapper = allWrappers[i];
        if (wrapper) {
          wrapper.classList.remove("hidden"); // Hilangkan display:none

          // Efek muncul berurutan (Staggered reveal)
          setTimeout(
            () => {
              wrapper.classList.remove("opacity-0", "translate-y-8");
            },
            60 * (i - currentlyVisible) // Penundaan setiap elemen sebesar 60ms
          );
        }
      }

      // Perbarui jumlah yang sedang terlihat
      currentlyVisible = nextLimit;

      // Jika semua proyek sudah dimuat
      if (currentlyVisible >= totalProjects) {
        loadMoreBtn.classList.add("opacity-50", "cursor-not-allowed");
        if (loadMoreText) loadMoreText.innerText = "ALL PROJECTS LOADED";
        if (loadMoreIcon) loadMoreIcon.classList.add("hidden");
      }
    });
  });
</script>
