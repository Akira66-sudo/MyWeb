---
// CtaBanner.astro
// Komponen Call-to-Action (CTA) di bagian bawah halaman.
// Menampilkan status ketersediaan, pesan utama, tombol kontak (modal), dan link Telegram.
import { getSiteData, getSocialLinks } from "../../lib/dataFetcher";

// Ambil data situs dan tautan sosial media
const { identity } = await getSiteData();
const socialLinks = await getSocialLinks();

// Cari link khusus untuk Telegram dari daftar social media
const telegramLink = socialLinks.find(
  (link) => (link.platform_name || "").toLowerCase() === "telegram"
);
---

<section class="relative bg-bg-base text-text-primary pt-24 pb-20 border-t border-border-strong">
  <div class="max-w-[1400px] mx-auto relative z-10 px-4 md:px-12">
    <!-- Tampilan Header Top CTA -->
    <div class="flex flex-col gap-10">
      <!-- Pulsa Status (Status Pulse) -->
      <div class="anim-fade-up flex flex-col items-start gap-4">
        <!-- Judul Bagian Standar (Section Header) -->
        <div class="flex items-center gap-4">
          <div class="w-8 md:w-12 h-px bg-text-primary"></div>
          <div
            class="mono text-[10px] md:text-xs uppercase tracking-widest text-text-primary font-bold"
          >
            COMMUNICATION / 05
          </div>
        </div>

        <!-- Indikator Status (Titik Berkedip) -->
        <div class="flex items-center gap-3">
          <span class="relative flex h-3 w-3">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#02B6E6] opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-[#02B6E6]"></span>
          </span>
          <span
            class="mono text-[9px] md:text-xs uppercase tracking-widest text-text-secondary font-bold"
          >
            {identity.status || "AVAILABLE FOR FREELANCE & FULL-TIME POSITIONS"}
          </span>
        </div>

        <!-- Teks Utama yang Besar (Giant Headline) -->
        <div class="anim-fade-up delay-100 flex flex-col gap-2 md:gap-4">
          <h2
            class="serif text-4xl sm:text-6xl md:text-8xl lg:text-[7rem] font-black tracking-tight leading-[0.9]"
          >
            Have an idea?<br />
            Let's build something<br />
            <span class="italic text-text-secondary">extraordinary.</span>
          </h2>
        </div>

        <!-- Tombol Aksi (Action Buttons) -->
        <div
          class="anim-fade-up delay-200 flex flex-col sm:flex-row items-center justify-start sm:justify-center lg:justify-start gap-3 sm:gap-6 pt-4"
        >
          <button
            id="open-contact-modal"
            class="w-full sm:w-auto justify-center mono text-[9px] md:text-xs font-bold uppercase tracking-[0.2em] px-6 py-4 md:px-8 md:py-5 bg-text-primary text-bg-base hover:opacity-80 hover:scale-105 active:scale-95 transition-all duration-300 rounded-full shadow-xl flex items-center gap-3 group/btn cursor-pointer"
          >
            <span>START A CONVERSATION</span>
            <i
              class="ri-arrow-right-up-line text-sm md:text-lg group-hover/btn:translate-x-1 group-hover/btn:-translate-y-1 transition-transform"
            ></i>
          </button>

          {
            telegramLink && (
              <a
                href={telegramLink.url}
                target="_blank"
                class="w-full sm:w-auto justify-center mono text-[9px] md:text-xs font-bold uppercase tracking-[0.2em] px-6 py-4 md:px-8 md:py-5 border border-border-strong text-text-secondary hover:text-text-primary hover:border-text-primary transition-all rounded-full flex items-center gap-3"
              >
                <i
                  class={`${telegramLink.icon_class || "ri-telegram-line"} text-sm md:text-base`}
                />
                <span>TELEGRAM DIRECT</span>
              </a>
            )
          }
        </div>
      </div>
    </div>

    <!-- Modal Kontak (Muncul saat tombol ditekan) -->
    <div
      id="contact-modal"
      class="fixed inset-0 z-[100] flex items-center justify-center bg-black/50 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300"
    >
      <div
        id="contact-modal-box"
        class="bg-bg-base border border-border-strong rounded-lg p-8 max-w-sm w-full mx-4 shadow-2xl text-center relative overflow-hidden transform scale-95 transition-transform duration-300"
      >
        <div id="contact-modal-content">
          <h3
            class="text-xl font-bold uppercase tracking-widest text-text-primary mb-2 flex items-center justify-center gap-2"
          >
            <span>NEW TRANSMISSION</span>
            <i class="ri-send-plane-fill text-[#02B6E6] text-2xl"></i>
          </h3>
          <p class="text-xs text-text-secondary mb-6 mono">Initiate secure connection.</p>

          <form id="contact-form" class="flex flex-col gap-4 mt-2">
            <!-- Web3Forms Access Key (Kunci Akses) -->
            <input type="hidden" name="access_key" value="2e75e365-8503-4778-b122-9878346b0423" />
            <!-- Honeypot untuk perlindungan dari spam bot -->
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <input
              type="text"
              name="name"
              required
              placeholder="Your Name"
              class="w-full bg-transparent border-b border-border-strong text-center text-lg font-bold mono text-text-primary py-2 focus:outline-none focus:border-[#02B6E6] transition-colors"
              autocomplete="off"
              spellcheck="false"
            />

            <input
              type="email"
              name="email"
              required
              placeholder="Your Email"
              class="w-full bg-transparent border-b border-border-strong text-center text-lg font-bold mono text-text-primary py-2 focus:outline-none focus:border-[#02B6E6] transition-colors"
              autocomplete="off"
              spellcheck="false"
            />

            <textarea
              name="message"
              required
              placeholder="Your Message"
              rows="3"
              class="w-full bg-transparent border-b border-border-strong text-center text-base font-bold mono text-text-primary py-2 focus:outline-none focus:border-[#02B6E6] transition-colors resize-none"
              spellcheck="false"></textarea>

            <p
              id="contact-modal-error"
              class="text-red-500 text-[10px] mono uppercase tracking-widest h-4 opacity-0 transition-opacity"
            >
            </p>

            <div class="flex gap-4 mt-2">
              <button
                type="button"
                id="contact-modal-cancel"
                class="flex-1 py-3 border border-border-strong text-text-secondary hover:text-text-primary hover:bg-text-primary/5 rounded-full mono uppercase tracking-widest font-bold transition-all text-xs cursor-pointer"
                >Cancel</button
              >
              <button
                type="submit"
                id="contact-modal-submit"
                class="flex-1 py-3 bg-text-primary text-bg-base hover:bg-[#02B6E6] hover:text-text-primary rounded-full mono uppercase tracking-widest font-bold transition-all text-xs cursor-pointer shadow-lg"
                >Transmit</button
              >
            </div>
          </form>
        </div>

        <!-- Status Sukses (Success State) -->
        <div id="contact-success" class="hidden flex-col items-center justify-center py-8">
          <i class="ri-checkbox-circle-fill text-[#02B6E6] text-6xl mb-6"></i>
          <p class="mono text-text-primary font-bold tracking-widest uppercase mb-2">
            TRANSMISSION SUCCESSFUL
          </p>
          <p class="text-xs text-text-secondary mono">Awaiting response...</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const openBtn = document.getElementById("open-contact-modal");
      const modal = document.getElementById("contact-modal");
      const modalBox = document.getElementById("contact-modal-box");
      const cancelBtn = document.getElementById("contact-modal-cancel");
      const form = document.getElementById("contact-form") as HTMLFormElement;
      const submitBtn = document.getElementById("contact-modal-submit");
      const errorMsg = document.getElementById("contact-modal-error");
      const contentDiv = document.getElementById("contact-modal-content");
      const successDiv = document.getElementById("contact-success");

      if (!openBtn || !modal || !cancelBtn || !form) return;

      // Fungsi Buka Modal
      openBtn.addEventListener("click", (e) => {
        e.preventDefault();
        modal.classList.remove("opacity-0", "pointer-events-none");
        modalBox.classList.remove("scale-95");
        modalBox.classList.add("scale-100");

        // Reset state formulir jika sebelumnya sudah pernah dibuka
        contentDiv.classList.remove("hidden");
        successDiv.classList.add("hidden");
        successDiv.classList.remove("flex");
        form.reset();
        errorMsg.classList.add("opacity-0");
        errorMsg.textContent = "";
        submitBtn.textContent = "Transmit";
        submitBtn.removeAttribute("disabled");
        submitBtn.classList.remove("opacity-50", "cursor-not-allowed");
      });

      // Fungsi Tutup Modal
      const closeModal = () => {
        modal.classList.add("opacity-0", "pointer-events-none");
        modalBox.classList.remove("scale-100");
        modalBox.classList.add("scale-95");
      };

      cancelBtn.addEventListener("click", closeModal);
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });

      // Tangani Pengiriman Form (Handle Form Submit)
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        // UI Loading state
        submitBtn.textContent = "TRANSMITTING...";
        submitBtn.setAttribute("disabled", "true");
        submitBtn.classList.add("opacity-50", "cursor-not-allowed");
        errorMsg.classList.add("opacity-0");

        const formData = new FormData(form);
        const object = Object.fromEntries(formData);
        const json = JSON.stringify(object);

        try {
          // Kirim ke API endpoint server-side Astro kita (pengganti Iron Dome client)
          const response = await fetch("/api/contact", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json"
            },
            body: json
          });

          const result = await response.json();

          if (response.status === 200 || response.ok) {
            // Berhasil!
            contentDiv.classList.add("hidden");
            successDiv.classList.remove("hidden");
            successDiv.classList.add("flex");

            // Tutup otomatis setelah 3 detik
            setTimeout(closeModal, 3000);
          } else {
            // Akan terpicu jika diblokir (403) atau ada error dari Web3Forms
            throw new Error(result.message || "Transmission failed.");
          }
        } catch (error) {
          // Error jaringan atau API (Termasuk diblokir karena kata-kata kasar/Profanity block)
          errorMsg.textContent = error.message || "Network error. Try again.";
          errorMsg.classList.remove("opacity-0");
          submitBtn.textContent = "Transmit";
          submitBtn.removeAttribute("disabled");
          submitBtn.classList.remove("opacity-50", "cursor-not-allowed");
        }
      });
    });
  </script>
</section>
