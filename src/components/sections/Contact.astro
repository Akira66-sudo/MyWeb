---
// Contact.astro
// Komponen Footer yang menampung informasi logo besar, daftar navigasi cepat,
// ringkasan keahlian (Presence), serta deretan tautan sosial media dan email.
import { getSiteData, getSocialLinks } from "../../lib/dataFetcher";

// Ambil data identitas dan data sosial media dari backend/JSON
const { identity } = await getSiteData();
const socialLinks = await getSocialLinks();
---

<footer
  id="contact"
  class="relative overflow-hidden bg-[#1C1C1A] text-[#F5F4F0] min-h-screen flex flex-col justify-between gap-16 lg:gap-24 pt-24 pb-16 border-t border-[#A8A8A4]/20"
>
  <!-- Lapisan Efek Noise (Noise Overlay for Footer) -->
  <div class="absolute inset-0 z-0 bg-noise opacity-10"></div>

  <div class="max-w-[1400px] mx-auto relative z-10 flex flex-col gap-20 px-4 md:px-12">
    <!-- Logo Besar / Nama Identitas (Giant Logo/Name) -->
    <div
      class="flex flex-col md:flex-row justify-between items-start md:items-end gap-12 group/footer cursor-default"
    >
      <h2
        class="serif text-[13vw] leading-[0.7] font-black tracking-tighter opacity-20 text-stroke-1 text-stroke-hover transition-all duration-700 ease-out select-none"
      >
        zidan-idz
      </h2>
      <div class="flex flex-col gap-4 text-left md:text-right w-full md:max-w-xs">
        <div class="mono uppercase tracking-widest text-[#A8A8A4] font-bold text-[10px]">
          ALL SYSTEMS OPERATIONAL
        </div>
        <p class="text-sm text-[#A8A8A4] font-medium">
          {
            identity.footer_bio ||
              "Fullstack Developer & Game Creator engineering web solutions, Python systems, and interactive experiences with precision."
          }
        </p>
      </div>
    </div>
  </div>

  <!-- Kotak Kisi Kontak & Navigasi (Contact Grid) -->
  <div class="max-w-[1400px] mx-auto w-full px-4 md:px-12 relative z-10">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-[#A8A8A4]/20 border border-[#A8A8A4]/20 shadow-2xl"
    >
    <!-- Kolom 1: Navigasi Cepat (Navigation) -->
    <div class="bg-[#1C1C1A] p-8 md:p-12 flex flex-col gap-8">
      <div class="mono text-[10px] font-bold uppercase tracking-[0.3em] text-[#A8A8A4]">
        NAVIGATION
      </div>
      <ul class="flex flex-col gap-4">
        <li>
          <a
            href="#"
            class="text-xs font-bold uppercase tracking-widest text-[#A8A8A4] hover:text-[#02B6E6] transition-all flex items-center gap-2 group/link"
            ><span class="w-0 group-hover/link:w-3 h-px bg-[#02B6E6] transition-all"></span>HOME</a
          >
        </li>
        <li>
          <a
            href="#about"
            class="text-xs font-bold uppercase tracking-widest text-[#A8A8A4] hover:text-[#02B6E6] transition-all flex items-center gap-2 group/link"
            ><span class="w-0 group-hover/link:w-3 h-px bg-[#02B6E6] transition-all"></span>ABOUT</a
          >
        </li>
        <li>
          <a
            href="#stack"
            class="text-xs font-bold uppercase tracking-widest text-[#A8A8A4] hover:text-[#02B6E6] transition-all flex items-center gap-2 group/link"
            ><span class="w-0 group-hover/link:w-3 h-px bg-[#02B6E6] transition-all"></span>TECH
            STACK</a
          >
        </li>
        <li>
          <a
            href="#work"
            class="text-xs font-bold uppercase tracking-widest text-[#A8A8A4] hover:text-[#02B6E6] transition-all flex items-center gap-2 group/link"
            ><span class="w-0 group-hover/link:w-3 h-px bg-[#02B6E6] transition-all"
            ></span>PROJECTS</a
          >
        </li>
      </ul>
    </div>

    <!-- Kolom 2: Ringkasan Keahlian (Presence/Skills Summary) -->
    <div class="bg-[#1C1C1A] p-8 md:p-12 flex flex-col gap-8">
      <div class="mono text-[10px] font-bold uppercase tracking-[0.3em] text-[#A8A8A4]">
        PRESENCE
      </div>
      <ul class="flex flex-col gap-6">
        <li class="flex flex-col gap-1">
          <span class="serif font-bold text-lg">Web & Frontend</span>
          <span class="mono text-[9px] uppercase text-[#A8A8A4] tracking-widest"
            >Astro, JavaScript, Tailwind, Bootstrap</span
          >
        </li>
        <li class="flex flex-col gap-1">
          <span class="serif font-bold text-lg">Backend & Game Dev</span>
          <span class="mono text-[9px] uppercase text-[#A8A8A4] tracking-widest"
            >Python, Django, Laravel, Godot Engine</span
          >
        </li>
      </ul>
    </div>

    <!-- Kolom 3: Tautan Sosial & Email (Connect) -->
    <div class="bg-[#1C1C1A] p-8 md:p-12 flex flex-col gap-10">
      <div class="flex flex-col gap-8">
        <div class="mono text-[10px] font-bold uppercase tracking-[0.3em] text-[#A8A8A4]">
          CONNECT
        </div>
        <div class="flex flex-wrap gap-4">
          {
            socialLinks.map((link) => (
              // Render icon (FontAwesome atau RemixIcon), jika link gambar maka tampilkan img tag
              <a
                href={link.url}
                target="_blank"
                title={link.platform_name}
                class="w-10 h-10 flex items-center justify-center border border-[#A8A8A4]/30 hover:bg-[#02B6E6] hover:border-[#02B6E6] hover:text-[#1C1C1A] transition-all rounded-full"
              >
                {(link.icon_class || "").startsWith("ri-") ||
                (link.icon_class || "").startsWith("fa-") ? (
                  <i class={`${link.icon_class} text-lg`} />
                ) : (
                  <img
                    src={link.icon_class || ""}
                    alt={link.platform_name}
                    class="w-5 h-5 object-contain"
                  />
                )}
              </a>
            ))
          }
        </div>
      </div>
      <div class="flex flex-col gap-2 mt-auto">
        <div class="mono text-[9px] uppercase tracking-widest text-[#A8A8A4] opacity-60">
          Direct_Channel
        </div>
        <a
          href={`mailto:${identity.email}`}
          class="text-sm font-bold hover:text-[#02B6E6] transition-colors break-all"
        >
          {identity.email}
        </a>
      </div>
    </div>
    </div>
  </div>

  <!-- Bagian Paling Bawah Footer (Bottom Footer) -->
  <div class="max-w-[1400px] mx-auto w-full px-4 md:px-12 relative z-10 mt-auto">
    <div
      class="flex flex-col md:flex-row justify-between items-center gap-8 pt-12 border-t border-[#A8A8A4]/20"
    >
    <div class="mono text-[10px] opacity-40 uppercase tracking-widest">
      © 2026 zidan-idz. All Rights Reserved.
    </div>
    <div class="flex gap-6 md:gap-8 items-center">
      <span class="mono text-[10px] opacity-40 uppercase tracking-widest">Lombok, Indonesia</span>
      <span class="mono text-[10px] opacity-20">•</span>
      <span class="mono text-[10px] opacity-40 uppercase tracking-widest">Built with Astro</span>
    </div>
    </div>
  </div>
</footer>
