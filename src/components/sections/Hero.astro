---
// Hero.astro
// Komponen utama (Hero Section) yang pertama kali dilihat pengunjung.
// Menampilkan Nama, Peran (Role), Bio, dan tombol Call to Action (CTA).
import { getSiteData } from "../../lib/dataFetcher";
import { Image } from "astro:assets";
import heroBg from "../../assets/images/hero-bg.jpg";

// Ambil data identitas dari JSON/DB
const { identity } = await getSiteData();
---

<section
  class="relative min-h-screen flex flex-col justify-center items-center overflow-hidden pt-20 md:pt-32 pb-10 border-b-blueprint"
>
  <!-- Latar Belakang (Gambar dengan efek abu-abu & pudar) -->
  <div class="absolute inset-0 z-0">
    <Image
      src={heroBg}
      alt="Zen Workspace"
      class="w-full h-full object-cover opacity-[0.15]"
      style="filter: grayscale(100%) contrast(1.2);"
      loading="eager"
    />
    <!-- Gradasi menutupi ujung bawah gambar -->
    <div class="absolute inset-0 bg-gradient-to-b from-bg-base/30 via-transparent to-bg-base"></div>
  </div>

  <div
    class="relative z-10 w-full max-w-[1400px] mx-auto flex flex-col items-center text-center gap-6 md:gap-8 px-4 md:px-12"
  >
    <!-- Label Kecil (Role / Pekerjaan) -->
    <div
      class="anim-fade-up flex items-center gap-3 px-4 py-2 border border-border-strong bg-surface/70 backdrop-blur-md shadow-[0_8px_30px_rgb(0,0,0,0.04)] rounded-full hover:scale-105 transition-transform cursor-default"
    >
      <div class="relative flex h-2 w-2">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#02B6E6] opacity-75"
        ></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-[#02B6E6]"></span>
      </div>
      <span
        class="mono text-[9px] md:text-[10px] tracking-[0.2em] uppercase font-bold text-text-primary"
      >
        {identity.role || "FULLSTACK DEVELOPER"}
      </span>
    </div>

    <!-- Teks Nama Raksasa (Headline) -->
    <div class="flex flex-col items-center gap-4 md:gap-6">
      <h1
        class="anim-fade-up delay-100 text-giant font-black text-text-primary leading-[1.1] tracking-tighter max-w-5xl"
      >
        {identity.name || "Muhammad Raid Zaidani."}
      </h1>
      <div class="anim-fade-up delay-200 h-px bg-text-primary w-12 md:w-24"></div>
    </div>

    <!-- Subtitle (Deskripsi Singkat / Bio) -->
    <p
      class="anim-fade-up delay-200 text-sm md:text-lg text-text-primary/80 leading-relaxed max-w-2xl font-medium"
    >
      {identity.hero_bio}
    </p>

    <!-- Tombol Aksi (Call To Action - CTA) -->
    <div
      class="anim-fade-up delay-300 flex flex-col sm:flex-row items-center gap-4 mt-8 cursor-hover"
    >
      <a
        href="#work"
        class="magnetic-btn group relative w-full sm:w-auto flex items-center justify-center px-8 py-4 bg-text-primary text-bg-base font-bold tracking-widest uppercase text-[10px] md:text-xs rounded-full overflow-hidden hover:scale-105 transition-transform duration-500 shadow-[0_8px_30px_rgb(0,0,0,0.12)] hover:shadow-[0_8px_30px_rgb(0,0,0,0.2)]"
      >
        <span class="relative z-10 flex items-center gap-2">
          EXPLORE WORK
          <i
            class="ri-arrow-right-down-line text-sm group-hover:translate-x-1 group-hover:translate-y-1 transition-transform"
          ></i>
        </span>
        <!-- Efek mengkilap (Shine effect) saat diarahkan (hover) -->
        <div
          class="absolute inset-0 h-full w-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-[150%] group-hover:translate-x-[150%] transition-transform duration-700 ease-out z-0"
        >
        </div>
      </a>
      <a
        href={identity.resume_url || "#"}
        target="_blank"
        rel="noopener noreferrer"
        class="magnetic-btn group relative w-full sm:w-auto flex items-center justify-center px-8 py-4 border border-border-strong bg-surface/70 backdrop-blur-md text-text-primary font-bold tracking-widest uppercase text-[10px] md:text-xs rounded-full hover:border-text-primary transition-transform duration-500 shadow-sm"
      >
        <span class="relative z-10 flex items-center gap-2">
          DOWNLOAD CV
          <i
            class="ri-download-line text-sm text-[#02B6E6] group-hover:scale-110 transition-transform"
          ></i>
        </span>
      </a>
    </div>
  </div>

  <!-- Indikator Gulir (Scroll Indicator) - Tampil di layar desktop -->
  <div
    class="relative z-10 anim-fade-up delay-400 opacity-30 hidden sm:flex flex-col items-center gap-4 mt-12 md:mt-24 pb-8"
  >
    <span class="mono text-[9px] uppercase tracking-widest">SCROLL</span>
    <div class="w-px h-8 bg-text-primary"></div>
  </div>
</section>
