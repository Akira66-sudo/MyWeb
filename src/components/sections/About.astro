---
// About.astro
// Bagian ini menampilkan profil diri (gambar & nama), bio panjang,
// serta rincian fase perjalanan kerja (work phases).
import { getSiteData, getWorkPhases } from "../../lib/dataFetcher";

// Ambil data identitas dan fase kerja dari backend palsu/asli (JSON/DB)
const { identity } = await getSiteData();
const workPhases = await getWorkPhases();
---

<section id="about" class="relative overflow-hidden border-b-blueprint">
  <!-- Latar Belakang Garis-garis Blueprint (Architectural Grid Background) -->
  <div
    class="absolute inset-0 z-0 opacity-[0.02]"
    style="background-image: linear-gradient(var(--text-primary) 1px, transparent 1px), linear-gradient(90deg, var(--text-primary) 1px, transparent 1px); background-size: 80px 80px;"
  >
  </div>

  <div
    class="max-w-[1400px] mx-auto px-4 md:px-12 flex flex-col gap-20 md:gap-32 py-16 md:py-32 relative z-10"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24 items-center">
      <!-- Kolom Kiri: Foto Profil (Bisa berubah grayscale saat hover) -->
      <div class="lg:col-span-4 order-2 lg:order-1 anim-fade-up">
        <div
          class="relative aspect-[4/5] w-full max-w-sm mx-auto border border-border-strong p-3 bg-black/[0.02] group shadow-xl"
        >
          <div class="relative w-full h-full overflow-hidden bg-[#E4E4E0]">
            <img
              src="/images/profile.webp"
              alt="Profile"
              class="w-full h-full object-cover grayscale group-hover:grayscale-0 contrast-[1.05] group-hover:scale-105 transition-all duration-700 ease-out"
            />
          </div>
          <!-- Dekorasi Bingkai di Sudut Kanan Atas dan Kiri Bawah -->
          <div class="absolute top-0 right-0 w-8 h-8 border-t border-r border-text-primary/40">
          </div>
          <div class="absolute bottom-0 left-0 w-8 h-8 border-b border-l border-text-primary/40">
          </div>
        </div>
      </div>

      <!-- Kolom Kanan: Teks & Informasi (Right side Content) -->
      <div class="lg:col-span-8 order-1 lg:order-2 flex flex-col gap-10">
        <!-- Bagian Judul (Header) -->
        <div class="flex flex-col gap-6">
          <div class="anim-fade-up flex items-center gap-4">
            <div class="w-8 md:w-12 h-px bg-text-primary"></div>
            <div
              class="text-[10px] md:text-xs mono text-text-primary font-bold uppercase tracking-widest"
            >
              KNOW ME BETTER / 01
            </div>
          </div>
          <h2
            class="anim-fade-up delay-100 text-huge font-serif font-bold text-text-primary leading-tight tracking-tight"
          >
            {identity.about_title || "Behind the Code"}
          </h2>
        </div>

        <!-- Bagian Pengantar Bio (Intro) -->
        <div class="anim-fade-up delay-200 flex flex-col gap-8">
          <h3
            class="text-xl md:text-2xl font-serif font-bold text-text-primary/80 uppercase tracking-widest"
          >
            {identity.name}
          </h3>
          <p class="text-lg md:text-2xl text-text-secondary leading-relaxed font-medium">
            {identity.bio}
          </p>
        </div>

        <!-- Daftar Perjalanan/Fase Kerja (Detail Columns) -->
        <div
          class="anim-fade-up delay-300 grid grid-cols-1 sm:grid-cols-2 gap-8 pt-8 border-t border-border-strong"
        >
          {
            workPhases.map((phase, index) => (
              <div class="flex flex-col gap-4">
                <div class="text-[10px] mono text-python-blue uppercase tracking-widest font-bold">
                  PHASES / 0{index + 1}
                </div>
                <h4 class="text-base font-bold tracking-tight uppercase">{phase.title}</h4>
                <p class="text-sm text-text-secondary leading-relaxed">{phase.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
