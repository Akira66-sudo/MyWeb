---
// CustomCursor.astro
// Komponen yang menggantikan kursor bawaan mouse menjadi kursor custom
// (titik biru dengan cincin luar). Hanya aktif di perangkat non-layar sentuh.
---

<!-- Titik kursor bagian dalam (bergerak instan) -->
<div
  id="custom-cursor-dot"
  class="fixed top-0 left-0 w-2 h-2 bg-[#02B6E6] rounded-full pointer-events-none z-[9999] opacity-0 transition-opacity duration-300 transform -translate-x-1/2 -translate-y-1/2 hidden md:block"
>
</div>
<!-- Cincin kursor bagian luar (bergerak mengikuti titik dengan jeda animasi lambat) -->
<div
  id="custom-cursor-ring"
  class="fixed top-0 left-0 w-8 h-8 border border-[#02B6E6]/50 rounded-full pointer-events-none z-[9998] opacity-0 transition-opacity duration-300 transform -translate-x-1/2 -translate-y-1/2 hidden md:block"
>
</div>

<style is:global>
  @media (pointer: fine) {
    body {
      cursor: none;
    }
    a,
    button,
    input,
    textarea,
    select {
      cursor: none;
    }
    input,
    textarea {
      cursor: text;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Hanya jalankan pada perangkat yang mendukung kursor presisi (mouse/bukan touch screen)
    if (!window.matchMedia("(pointer: fine)").matches) return;

    const dot = document.getElementById("custom-cursor-dot");
    const ring = document.getElementById("custom-cursor-ring");

    if (!dot || !ring) return;

    let mouseX = -100;
    let mouseY = -100;
    let ringX = -100;
    let ringY = -100;
    let isHovering = false;
    let isVisible = false;

    // Tampilkan kursor saat mouse pertama kali digerakkan
    window.addEventListener("mousemove", (e) => {
      if (!isVisible) {
        dot.style.opacity = "1";
        ring.style.opacity = "1";
        isVisible = true;
      }
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    // Sembunyikan kursor jika mouse keluar dari layar browser
    document.addEventListener("mouseleave", () => {
      dot.style.opacity = "0";
      ring.style.opacity = "0";
      isVisible = false;
    });

    // Loop Animasi Pergerakan Kursor (dieksekusi setiap frame)
    const render = () => {
      // Titik mengikuti kursor secara presisi dan instan
      dot.style.transform = `translate(${mouseX}px, ${mouseY}px) translate(-50%, -50%)`;

      // Cincin mengikuti dengan efek kelambatan (Lerp / interpolasi linear)
      ringX += (mouseX - ringX) * 0.15;
      ringY += (mouseY - ringY) * 0.15;

      // Jika sedang mengarahkan kursor (hover) ke elemen interaktif:
      if (isHovering) {
        ring.style.transform = `translate(${ringX}px, ${ringY}px) translate(-50%, -50%) scale(1.5)`;
        ring.style.backgroundColor = "rgba(2, 182, 230, 0.1)"; // Warnai bagian dalam cincin
        dot.style.transform = `translate(${mouseX}px, ${mouseY}px) translate(-50%, -50%) scale(0)`; // Sembunyikan titik
      } else {
        // Mode kursor normal
        ring.style.transform = `translate(${ringX}px, ${ringY}px) translate(-50%, -50%) scale(1)`;
        ring.style.backgroundColor = "transparent";
      }

      requestAnimationFrame(render);
    };

    requestAnimationFrame(render);

    // Logika Hover: mendeteksi kapan kursor masuk atau keluar dari tombol/link
    const attachHoverEvents = () => {
      const interactiveElements = document.querySelectorAll("a, button, .cursor-hover");
      interactiveElements.forEach((el) => {
        el.addEventListener("mouseenter", () => (isHovering = true));
        el.addEventListener("mouseleave", () => (isHovering = false));
      });
    };

    attachHoverEvents();

    // Re-attach listener jika DOM berubah (berguna untuk konten yang dimuat belakangan)
    const observer = new MutationObserver(attachHoverEvents);
    observer.observe(document.body, { childList: true, subtree: true });

    // ── LOGIKA TOMBOL MAGNETIK (Magnetic Button) ──
    const attachMagneticEvents = () => {
      // Cari semua elemen dengan class 'magnetic-btn'
      const magneticElements = document.querySelectorAll(".magnetic-btn");
      magneticElements.forEach((elem) => {
        const el = elem as HTMLElement;
        // Cegah penempelan event listener berkali-kali
        if (el.dataset.magneticAttached) return;
        el.dataset.magneticAttached = "true";

        // Saat dihover, tarik elemen ke arah kursor sedikit
        el.addEventListener("mousemove", (e) => {
          const rect = el.getBoundingClientRect();
          const h = rect.width / 2;
          const v = rect.height / 2;
          const x = e.clientX - rect.left - h;
          const y = e.clientY - rect.top - v;

          // Tarik elemen (0.3 adalah kekuatan tarikan magnet)
          el.style.transform = `translate(${x * 0.3}px, ${y * 0.3}px)`;
        });

        // Kembalikan ke posisi semula saat ditinggalkan
        el.addEventListener("mouseleave", () => {
          el.style.transform = `translate(0px, 0px)`;
        });
      });
    };
    attachMagneticEvents();
  });
</script>
