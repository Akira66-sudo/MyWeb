---
---

<header class="w-full border-b-blueprint bg-bg-base/90 backdrop-blur-md sticky top-0 z-40">
  <div class="max-w-[1400px] mx-auto px-4 md:px-12 h-16 md:h-20 flex items-center justify-between">
    
    <!-- Brand -->
    <a href="/" class="text-xl md:text-2xl font-black tracking-tighter uppercase">
      ZIDAN.
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-8">
      {[
        { label: "WORK", href: "#work" },
        { label: "STACK", href: "#stack" },
        { label: "ABOUT", href: "#about" },
        { label: "CONTACT", href: "#contact" },
      ].map(({ label, href }) => (
        <a
          href={href}
          class="mono text-xs font-bold tracking-widest text-text-secondary hover:text-text-primary transition-colors"
        >
          {label}
        </a>
      ))}
    </nav>
    
    <!-- Mobile Menu Button -->
    <button class="md:hidden mono text-xs font-bold tracking-widest p-2">
      MENU
    </button>
  </div>
</header>
