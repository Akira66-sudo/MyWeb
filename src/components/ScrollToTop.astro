<button
  id="scroll-top"
  aria-label="Back to top"
  class="fixed bottom-6 right-6 z-50 w-10 h-10 bg-text-primary text-surface rounded-[10px] flex items-center justify-center shadow-[0_4px_16px_rgba(0,0,0,0.1)] opacity-0 -translate-y-2 pointer-events-none transition-all duration-300 hover:bg-[#3A3A37]"
>
  <i class="ri-arrow-up-line text-lg"></i>
</button>

<script is:inline>
  const btn = document.getElementById("scroll-top");
  window.addEventListener("scroll", () => {
    const show = window.scrollY > 500;
    btn.classList.toggle("opacity-0",        !show);
    btn.classList.toggle("opacity-100",       show);
    btn.classList.toggle("-translate-y-2",   !show);
    btn.classList.toggle("translate-y-0",     show);
    btn.classList.toggle("pointer-events-none", !show);
  }, { passive: true });
  btn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
</script>
