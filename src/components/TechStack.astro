---
import { getSiteData, getTechStacks } from "../lib/dataFetcher";
const { identity } = await getSiteData();
const techStacks = await getTechStacks();

// Convert directly from the new JSON format which is already grouped
const groups = techStacks.map(group => ({
  label: group.category,
  items: group.skills || []
}));

// We can still use the hardcoded icons for the Core Ecosystem visual matrix,
// but we only display the ones we mapped earlier. Alternatively, if icon_svg was populated in DB, we could use that.
// For now, I will keep the icon matrix using the simpleicons list as a visual flair, 
// or maybe rely on the names. The design for "Core Ecosystem" used a specific array.
// We'll keep the predefined array for the visual matrix to preserve the UI wow factor,
// but the actual lists above it are fully dynamic.
---

<section id="stack" class="relative overflow-hidden border-b-blueprint">
  
  <div class="max-w-[1400px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr]">
    
    <!-- Title Area -->
    <div class="py-8 px-4 md:py-12 md:px-12 lg:py-16 lg:px-16 border-b md:border-b-0 lg:border-r border-border-strong flex flex-col justify-center">
      <div class="anim-fade-up flex items-center gap-4 mb-8">
        <div class="w-10 h-px bg-python-blue"></div>
        <div class="mono text-[10px] uppercase tracking-widest font-bold text-python-blue">
          MODERN TECH STACK
        </div>
      </div>
      <h2 class="anim-fade-up delay-100 text-huge font-serif font-black tracking-tight leading-[0.9] mb-8">
        The<br/>
        <span class="italic text-text-muted">Technical</span><br/>
        Matrix.
      </h2>
      <p class="anim-fade-up delay-200 text-lg md:text-xl text-text-secondary font-medium max-w-md">
        {identity.tech_description || "A high-performance architecture built with the best tools in the industry."}
      </p>
    </div>

    <!-- Stack List -->
    <div class="flex flex-col">
      {groups.map((group, i) => (
        <div class="flex-1 py-8 px-4 md:py-12 md:px-12 border-b border-border-strong last:border-b-0 flex flex-col justify-center group hover:bg-black/[0.02] transition-colors">
          <div class="flex items-center justify-between mb-4">
            <span class="mono text-[10px] font-bold text-text-muted group-hover:text-python-blue transition-colors">0{i + 1}</span>
            <span class="text-xl font-bold uppercase tracking-tight">{group.label}</span>
          </div>
          <div class="flex flex-wrap justify-end gap-3 mt-4">
            {group.items.map(item => (
              <span class="text-sm md:text-base text-text-secondary font-medium">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
    
  </div>

  <!-- Visual Tech Matrix (Icon Grid) -->
  <div class="border-t border-border-strong py-16 md:py-24 flex flex-col items-center relative overflow-hidden">
    <!-- Architectural Grid Background -->
    <div class="absolute inset-0 z-0 opacity-[0.03]" style="background-image: linear-gradient(var(--text-primary) 1px, transparent 1px), linear-gradient(90deg, var(--text-primary) 1px, transparent 1px); background-size: 80px 80px;"></div>

    <div class="w-full max-w-[1400px] mx-auto px-4 md:px-12 relative z-10">
      
      <div class="anim-fade-up flex items-center justify-center gap-4 mb-12 md:mb-16">
        <div class="w-8 md:w-12 h-px bg-border-strong"></div>
        <span class="mono text-[9px] md:text-[10px] tracking-widest text-text-muted uppercase font-bold">CORE ECOSYSTEM</span>
        <div class="w-8 md:w-12 h-px bg-border-strong"></div>
      </div>
      
      <div class="grid grid-cols-4 md:grid-cols-5 lg:grid-cols-7 gap-y-6 md:gap-y-12 gap-x-8 md:gap-16 place-items-center">
        {[
          "html5", "css3", "javascript", "tailwindcss", "bootstrap", "astro",
          "python", "django", "flask", "fastapi", "php", "laravel",
          "postgresql", "mysql", "sqlite", "supabase", "firebase", 
          "godotengine", "git", "github", "linux"
        ].map(slug => (
          <div class="group relative flex items-center justify-center p-4">
            <img 
              src={`https://cdn.simpleicons.org/${slug}`} 
              alt={slug}
              class="w-10 h-10 md:w-14 md:h-14 opacity-20 grayscale brightness-0 group-hover:opacity-100 group-hover:grayscale-0 group-hover:brightness-100 group-hover:scale-110 transition-all duration-500 object-contain drop-shadow-sm"
            />
          </div>
        ))}
      </div>
    </div>
  </div>

</section>
