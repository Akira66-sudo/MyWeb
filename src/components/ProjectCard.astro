---
import { Image } from "astro:assets";
interface Props {
  index: number;
  title: string;
  category: string;
  description: string;
  techStack: string[];
  link: string | null;
  demo: string | null;
}
const { index, title, category, description, techStack, link, demo } = Astro.props;
const idx = index < 10 ? `0${index}` : index;
---

<div class="group border-b border-border-strong last:border-b-0">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 py-8 px-4 md:py-12 md:px-12 items-center hover:bg-black/[0.02] transition-colors duration-500">
    
    <!-- Hero Image -->
    <div class="lg:col-span-5 w-full aspect-[4/3] overflow-hidden bg-border-strong/20 relative shadow-sm">
      <div class="absolute inset-0 bg-text-primary/10 group-hover:bg-transparent transition-colors duration-500 z-10 pointer-events-none"></div>
      <Image 
        src={`https://picsum.photos/seed/${title.replace(/\s+/g, '')}/800/600?grayscale`} 
        alt={title} 
        width={800}
        height={600}
        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out grayscale group-hover:grayscale-0"
        loading="lazy"
      />
    </div>

    <!-- Content -->
    <div class="lg:col-span-7 flex flex-col gap-6">
      
      <!-- Top info: Number & Category -->
      <div class="flex items-center gap-6">
        <div class="serif text-4xl md:text-5xl font-bold text-text-muted group-hover:text-[#02B6E6] transition-colors duration-500">
          {idx}
        </div>
        <div class="h-px flex-1 bg-border-strong transition-colors group-hover:bg-[#02B6E6]/40"></div>
        <div class="mono text-[10px] uppercase tracking-widest font-bold text-text-primary">
          {category}
        </div>
      </div>

      <!-- Title & Description -->
      <div class="flex flex-col gap-4">
        <h3 class="serif text-3xl md:text-5xl font-black text-text-primary leading-[1.1] tracking-tight group-hover:translate-x-2 transition-transform duration-500">
          {title}
        </h3>
        <p class="text-text-secondary text-sm md:text-base leading-relaxed max-w-2xl">
          {description}
        </p>
      </div>

      <!-- Tech Stack -->
      <div class="flex flex-wrap gap-2 mt-2">
        {techStack.map(tech => (
          <span class="px-2 py-1 border border-border-strong bg-white/50 text-[9px] mono uppercase tracking-wider text-text-secondary hover:text-[#02B6E6] group-hover:border-[#02B6E6]/40 transition-colors">
            {tech}
          </span>
        ))}
      </div>

      <!-- Links -->
      <div class="flex flex-wrap gap-6 mt-4">
        {demo && demo !== '#' && demo !== '' && (
          <a href={demo} target="_blank" rel="noopener noreferrer" class="text-sm font-bold uppercase tracking-widest hover:text-[#02B6E6] flex items-center gap-2 group/link transition-colors">
            <span class="w-0 group-hover/link:w-4 h-px bg-[#02B6E6] transition-all"></span>
            Live Demo
          </a>
        )}
        {link && link !== '#' && link !== '' && (
          <a href={link} target="_blank" rel="noopener noreferrer" class="text-sm font-bold uppercase tracking-widest text-text-muted hover:text-[#02B6E6] flex items-center gap-2 group/link transition-colors">
            <span class="w-0 group-hover/link:w-4 h-px bg-[#02B6E6] transition-all"></span>
            Repository
          </a>
        )}
      </div>

    </div>
  </div>
</div>
