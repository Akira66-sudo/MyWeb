---
import { getProjects } from "../lib/dataFetcher";
import ProjectCard from "./ProjectCard.astro";
const projects = await getProjects();
---

<section id="work" class="relative overflow-hidden border-b-blueprint bg-bg-base">
  <!-- Architectural Grid Background -->
  <div class="absolute inset-0 z-0 opacity-[0.02]" style="background-image: linear-gradient(var(--text-primary) 1px, transparent 1px), linear-gradient(90deg, var(--text-primary) 1px, transparent 1px); background-size: 80px 80px;"></div>
  
  <div class="max-w-[1400px] mx-auto border-x-0 2xl:border-x border-border-strong relative z-10">
    
    <!-- Header -->
    <div class="py-8 px-4 md:py-12 md:px-12 lg:py-16 border-b border-border-strong flex justify-between items-start md:items-end flex-wrap gap-8">
      <div class="flex flex-col gap-6">
        <div class="anim-fade-up flex items-center gap-4">
          <div class="w-10 h-px bg-python-blue"></div>
          <div class="mono text-[10px] uppercase tracking-widest font-bold text-python-blue">
            Selected Works / 03
          </div>
        </div>
        <h2 class="anim-fade-up delay-100 text-5xl md:text-8xl lg:text-[7rem] font-serif font-black tracking-tight leading-[0.9]">
          Featured<br/>Projects.
        </h2>
      </div>
      
      <div class="anim-fade-up delay-200 text-left md:text-right pb-2 w-full md:w-auto">
        <div class="mono text-[10px] uppercase tracking-widest text-text-muted mb-2">Total Archives</div>
        <div class="serif text-4xl font-bold">{projects.length < 10 ? `0${projects.length}` : projects.length}</div>
      </div>
    </div>

    <!-- Project List -->
    <div id="projects-list" class="flex flex-col">
      {projects.map((project, index) => (
        <div 
          class={`project-card-wrapper transition-all duration-500 ${index >= 5 ? 'hidden opacity-0 translate-y-8' : ''}`}
          data-project-index={index}
        >
          <ProjectCard 
            index={index + 1}
            title={project.title}
            category={project.category}
            description={project.description}
            techStack={project.techStack}
            link={project.link}
            demo={project.demo}
          />
        </div>
      ))}
    </div>

    {projects.length > 5 && (
      <div id="load-more-container" class="py-12 px-4 md:px-12 border-t border-border-strong flex justify-center bg-bg-base">
        <button 
          id="btn-load-more" 
          class="mono text-xs font-bold uppercase tracking-[0.25em] px-8 py-4 bg-[#1C1C1A] text-[#F5F4F0] hover:bg-white hover:text-[#1C1C1A] border border-border-strong rounded-full transition-all duration-300 shadow-xl flex items-center gap-3 group cursor-pointer"
        >
          <span id="btn-load-more-text">LOAD MORE</span>
          <i id="btn-load-more-icon" class="ri-add-line text-base group-hover:rotate-180 transition-transform duration-500"></i>
        </button>
      </div>
    )}

  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const loadMoreBtn = document.getElementById("btn-load-more");
    const loadMoreText = document.getElementById("btn-load-more-text");
    const loadMoreIcon = document.getElementById("btn-load-more-icon");

    if (!loadMoreBtn) return;

    let currentlyVisible = 5;
    const step = 5;
    const allWrappers = document.querySelectorAll(".project-card-wrapper");
    const totalProjects = allWrappers.length;

    loadMoreBtn.addEventListener("click", () => {
      const nextLimit = Math.min(currentlyVisible + step, totalProjects);

      for (let i = currentlyVisible; i < nextLimit; i++) {
        const wrapper = allWrappers[i];
        if (wrapper) {
          wrapper.classList.remove("hidden");
          // Staggered reveal
          setTimeout(() => {
            wrapper.classList.remove("opacity-0", "translate-y-8");
          }, 60 * (i - currentlyVisible));
        }
      }

      currentlyVisible = nextLimit;

      if (currentlyVisible >= totalProjects) {
        loadMoreBtn.classList.add("opacity-50", "cursor-not-allowed");
        if (loadMoreText) loadMoreText.innerText = "ALL PROJECTS LOADED";
        if (loadMoreIcon) loadMoreIcon.classList.add("hidden");
      }
    });
  });
</script>
