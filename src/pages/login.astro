---
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login | Behind the Code</title>
    
    <link rel="icon" type="image/webp" href="/images/icon.webp" />
    <link rel="apple-touch-icon" href="/images/icon.webp" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
  </head>

  <body class="bg-[#1C1C1A] text-white antialiased overflow-x-hidden min-h-screen">
    
    <div class="min-h-screen w-full flex flex-col lg:flex-row bg-[#1C1C1A]">
      
      <!-- Left Panel: Graphic & Welcome (Full Height) -->
      <div class="lg:w-[50%] w-full bg-[#03B6E5] p-10 lg:p-24 flex flex-col justify-center relative overflow-hidden min-h-[40vh] lg:min-h-screen">
        
        <!-- Abstract Shapes -->
        <div class="absolute -top-10 -right-10 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-10 -left-10 w-64 h-64 bg-black/10 rounded-full blur-3xl"></div>
        
        <!-- Diagonal Pills -->
        <div class="absolute bottom-12 left-10 w-48 h-12 bg-white/20 rounded-full -rotate-45 transform origin-bottom-left blur-[1px]"></div>
        <div class="absolute bottom-20 left-32 w-32 h-8 bg-[#1C1C1A]/10 rounded-full -rotate-45 transform origin-bottom-left blur-[1px]"></div>
        <div class="absolute bottom-32 left-16 w-56 h-10 bg-white/15 rounded-full -rotate-45 transform origin-bottom-left blur-[1px]"></div>
        <div class="absolute top-20 right-10 w-24 h-6 bg-[#1C1C1A]/10 rounded-full -rotate-45 transform origin-bottom-left blur-[1px]"></div>

        <div class="relative z-10 text-[#1C1C1A]">
          <h1 class="text-4xl lg:text-5xl font-extrabold tracking-tight mb-4 text-[#1C1C1A]">
            Behind the Code.
          </h1>
          <p class="text-sm lg:text-base font-medium opacity-80 leading-relaxed max-w-sm text-[#1C1C1A]">
            Portfolio and content management system.
          </p>
        </div>
      </div>

      <!-- Right Panel: Login Form (Full Height) -->
      <div class="lg:w-[50%] w-full bg-[#1C1C1A] p-10 lg:p-24 flex flex-col justify-center relative min-h-[60vh] lg:min-h-screen">
        <div class="max-w-md w-full mx-auto">
          
          <div class="mb-10">
            <h2 class="text-3xl font-bold text-white tracking-tight mb-2">Sign In</h2>
            <p class="text-sm text-white/50 font-medium">Enter your credentials to access the dashboard.</p>
          </div>

          <!-- Error Box -->
          <div id="error-box" class="hidden mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-red-400 text-xs font-medium text-left"></div>

          <!-- Form -->
          <form id="login-form" class="space-y-5" onsubmit="event.preventDefault(); return false;">
            <div>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-white/40">
                  <i class="ri-mail-line text-lg"></i>
                </div>
                <input 
                  type="text" 
                  id="email" 
                  required
                  placeholder="Email or Username" 
                  class="w-full bg-[#262626] border border-[#262626] focus:border-[#03B6E5] text-white pl-12 pr-4 py-4 rounded-xl text-sm outline-none transition-all placeholder:text-white/30 font-medium"
                />
              </div>
            </div>

            <div>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-white/40">
                  <i class="ri-lock-line text-lg"></i>
                </div>
                <input 
                  type="password" 
                  id="password" 
                  required
                  placeholder="Password" 
                  class="w-full bg-[#262626] border border-[#262626] focus:border-[#03B6E5] text-white pl-12 pr-4 py-4 rounded-xl text-sm outline-none transition-all placeholder:text-white/30 font-medium"
                />
              </div>
            </div>

            <button 
              type="submit" 
              id="submit-btn"
              class="w-full py-4 bg-[#03B6E5] hover:bg-[#029bc4] text-[#1C1C1A] font-bold text-sm rounded-xl transition-all shadow-lg flex items-center justify-center gap-2 mt-6"
            >
              <span>Continue</span>
              <i class="ri-arrow-right-line"></i>
            </button>
          </form>
          
        </div>
      </div>

    </div>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("login-form");
        const emailInput = document.getElementById("email");
        const passInput = document.getElementById("password");
        const errorBox = document.getElementById("error-box");
        const submitBtn = document.getElementById("submit-btn");

        if (form) {
          form.addEventListener("submit", (e) => {
            e.preventDefault();
            
            const email = emailInput ? emailInput.value.trim() : "";
            const password = passInput ? passInput.value : "";
            
            if (!email || !password) {
              alert("Email dan Password harus diisi!");
              return;
            }

            if (submitBtn) {
              submitBtn.setAttribute("disabled", "true");
              submitBtn.innerHTML = `<span class="animate-pulse">Verifying...</span>`;
            }

            const devEmails = ["admin@system.local", "admin@zidan.com", "admin", "root"];
            const devPasses = ["admin", "admin123", "zidan123", "root", "password"];
            
            if (devEmails.includes(email.toLowerCase()) && devPasses.includes(password)) {
              document.cookie = "sb-access-token=master-dev-token-999; path=/; max-age=86400; SameSite=Lax";
              window.location.href = "/admin";
            } else {
              if (errorBox) {
                errorBox.innerText = "Access Denied: Invalid credentials or database offline.";
                errorBox.classList.remove("hidden");
              }
              if (submitBtn) {
                submitBtn.removeAttribute("disabled");
                submitBtn.innerHTML = `<span>Continue</span> <i class="ri-arrow-right-line"></i>`;
              }
            }
          });
        }
      });
    </script>
  </body>
</html>
